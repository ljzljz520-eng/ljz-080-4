{
  "name": "fleetcare-dispatch",
  "private": true,
  "version": "1.0.0",
  "description": "工程机械保养智能派单系统（租赁同步 / 周期派单 / 技师外勤离线填报 / 客户确认）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "seed": "node -e \"import('./server/db.js').then(m=>m.resetDb())\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
